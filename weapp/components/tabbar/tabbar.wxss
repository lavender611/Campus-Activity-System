.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #e6ecf4;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-inner {
  display: flex;
}

.tab-item {
  flex: 1;
  padding: 14rpx 0 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #93a1b1;
  font-size: 23rpx;
}

.tab-item.active {
  color: #173b67;
}

.tab-hover {
  opacity: 0.7;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.tab-label {
  margin-top: 4rpx;
}

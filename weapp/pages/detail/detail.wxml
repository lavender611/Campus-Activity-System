<status-bar userName="{{userName}}" demoMode="{{demoMode}}" />

<view class="page with-action">
  <view wx:if="{{loading}}" class="loading">
    <view class="spinner"></view>
    <text>正在加载…</text>
  </view>

  <block wx:elif="{{activity}}">
    <view class="detail-head">
      <text class="tag">{{activity.category}}</text>
      <text class="head-title">{{activity.title}}</text>
      <text class="head-sub">{{activity.dateText}} {{activity.timeText}} · {{activity.location}}</text>
      <view class="seat" style="margin-top: 24rpx">
        <view class="progress" style="background: rgba(255,255,255,0.22)">
          <view class="bar {{isFull ? 'full' : ''}}" style="width: {{rate}}%"></view>
        </view>
        <text class="seat-text">{{count}} / {{activity.capacity}} 人</text>
      </view>
    </view>

    <view class="card" style="margin-top: 24rpx">
      <view class="info-list">
        <view class="info-item">
          <text class="k">活动地点</text>
          <text class="v">{{activity.location}}</text>
        </view>
        <view class="info-item">
          <text class="k">活动时间</text>
          <text class="v">{{activity.rangeText}}</text>
        </view>
        <view class="info-item">
          <text class="k">报名名额</text>
          <text class="v">{{activity.capacity}} 人（已报 {{count}} 人）</text>
        </view>
        <view class="info-item">
          <text class="k">活动状态</text>
          <text class="v">
            <text class="tag {{statusClass}}">{{statusText}}</text>
          </text>
        </view>
      </view>
    </view>

    <view class="section-label">活动介绍</view>
    <view class="card">
      <text class="desc-text">{{activity.description || '暂无详细介绍'}}</text>
    </view>
  </block>

  <view wx:if="{{activity}}" class="bottom-action">
    <block wx:if="{{role === 'admin'}}">
      <view class="hint">管理员账号不参与报名，可在“活动管理”中查看报名名单</view>
      <view class="btn btn-ghost btn-block" bindtap="goRoster" hover-class="btn-hover">查看报名名单</view>
    </block>

    <block wx:elif="{{role === '游客'}}">
      <view class="hint">登录学生账号后即可报名</view>
      <view class="btn btn-primary btn-block" bindtap="goLogin" hover-class="btn-hover">去登录</view>
    </block>

    <block wx:elif="{{registered}}">
      <view
        class="btn btn-danger btn-block {{submitting ? 'btn-disabled' : ''}}"
        bindtap="cancel"
        hover-class="btn-hover"
      >{{submitting ? '处理中…' : '取消报名'}}</view>
    </block>

    <block wx:else>
      <view wx:if="{{isFull}}" class="hint">该活动名额已满，可稍后再来看看</view>
      <view
        class="btn btn-primary btn-block {{isFull || submitting ? 'btn-disabled' : ''}}"
        bindtap="register"
        hover-class="btn-hover"
      >{{submitting ? '提交中…' : (isFull ? '名额已满' : '立即报名')}}</view>
    </block>
  </view>
</view>

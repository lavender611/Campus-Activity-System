page {
  --brand: #173b67;
  --brand-light: #2f5f95;
  --brand-soft: #e8effa;
  --accent: #e8a13a;
  --bg: #f3f6fb;
  --card: #ffffff;
  --text: #22303f;
  --muted: #7c8a9b;
  --line: #e6ecf4;
  --danger: #d94a4a;
  --success: #2f9e6f;

  background: #f3f6fb;
  color: #22303f;
  font-size: 30rpx;
  line-height: 1.55;
  font-family: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.page {
  padding: 28rpx 28rpx 40rpx;
}

/* 底部有自定义 tabbar 的页面，额外留出高度 */
.page.with-tabbar {
  padding-bottom: 190rpx;
}

/* 详情页底部有操作栏 */
.page.with-action {
  padding-bottom: 240rpx;
}

/* ---------- 顶部状态条 ---------- */
.status-bar {
  display: flex;
  align-items: center;
  padding: 6rpx 28rpx 0;
  font-size: 24rpx;
  color: #7c8a9b;
}

.status-bar .who {
  margin-left: auto;
}

.demo-flag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f0b95a;
  color: #4a3006;
  font-size: 23rpx;
  font-weight: 600;
}

/* ---------- 通用组件 ---------- */
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 12rpx 36rpx rgba(23, 59, 103, 0.07);
  border: 1rpx solid rgba(230, 236, 244, 0.9);
}

.section-label {
  font-size: 25rpx;
  color: #7c8a9b;
  margin: 36rpx 8rpx 16rpx;
  letter-spacing: 1rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.btn-hover {
  opacity: 0.82;
}

.btn-primary {
  background: linear-gradient(135deg, #1a3f6d, #2f5f95);
  color: #ffffff;
}

.btn-ghost {
  background: #e8effa;
  color: #173b67;
}

.btn-danger {
  background: #fdeaea;
  color: #d94a4a;
}

.btn-plain {
  background: #ffffff;
  color: #173b67;
  border: 1rpx solid #d7e2f0;
}

.btn-disabled {
  opacity: 0.55;
}

.btn-block {
  width: 100%;
}

.btn-sm {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  border-radius: 20rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: #ffffff;
  color: #63748a;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(23, 59, 103, 0.06);
}

.chip.active {
  background: #173b67;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 59, 103, 0.22);
}

.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  background: #e8effa;
  color: #2f5f95;
  flex: none;
}

.tag.green {
  background: #e7f6ef;
  color: #2f9e6f;
}

.tag.gray {
  background: #eef1f5;
  color: #8494a6;
}

.tag.orange {
  background: #fdf2e0;
  color: #b57517;
}

/* ---------- 搜索 ---------- */
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(23, 59, 103, 0.07);
}

.search-box .search-icon {
  font-size: 28rpx;
  color: #9aa8b8;
  margin-right: 12rpx;
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
  color: #22303f;
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #5b6b7d;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.field input,
.field textarea,
.field .picker-value {
  width: 100%;
  border: 1rpx solid #dde5ef;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  background: #ffffff;
  font-size: 30rpx;
  color: #22303f;
}

.field textarea {
  min-height: 200rpx;
  line-height: 1.6;
}

.field .picker-value.placeholder {
  color: #a7b3c2;
}

.field .picker-row {
  display: flex;
}

.field .picker-row .picker-col {
  flex: 1;
}

.field .picker-row .picker-col:first-child {
  margin-right: 16rpx;
}

.field-hint {
  font-size: 24rpx;
  color: #7c8a9b;
  margin-top: 10rpx;
}

/* ---------- 空白 / 加载 ---------- */
.empty {
  text-align: center;
  padding: 92rpx 40rpx;
  color: #7c8a9b;
  font-size: 28rpx;
}

.empty .empty-icon {
  font-size: 68rpx;
  opacity: 0.5;
  display: block;
  margin-bottom: 16rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #7c8a9b;
  font-size: 26rpx;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 16rpx;
  border: 4rpx solid #dbe4f0;
  border-top-color: #2f5f95;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------- 活动卡片 ---------- */
.activity-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(23, 59, 103, 0.07);
  border: 1rpx solid rgba(230, 236, 244, 0.9);
}

.card-hover {
  transform: scale(0.985);
}

.activity-card .ac-top {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.activity-card .ac-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 33rpx;
  line-height: 1.35;
  font-weight: 700;
}

.activity-card .desc {
  color: #5f7086;
  font-size: 27rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta-row {
  display: flex;
  color: #7c8a9b;
  font-size: 25rpx;
  margin-bottom: 8rpx;
}

.meta-row .meta-icon {
  width: 32rpx;
  flex: none;
  opacity: 0.8;
}

.meta-row .meta-text {
  flex: 1;
}

.seat {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.progress {
  flex: 1;
  height: 12rpx;
  border-radius: 12rpx;
  background: #eef2f8;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress .bar {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #2f5f95, #79a3d6);
}

.progress .bar.full {
  background: linear-gradient(90deg, #d98b2b, #e8a13a);
}

.seat-text {
  font-size: 25rpx;
  color: #6c7c8f;
  white-space: nowrap;
}

/* ---------- 详情 ---------- */
.detail-head {
  background: linear-gradient(150deg, #1a3f6d, #2c5c90);
  color: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 20rpx 52rpx rgba(23, 59, 103, 0.2);
}

.detail-head .tag {
  background: rgba(255, 255, 255, 0.16);
  color: #eaf2ff;
}

.detail-head .head-title {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 700;
}

.detail-head .head-sub {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
}

.detail-head .seat-text {
  color: #ffffff;
}

.info-list {
  margin-top: 24rpx;
}

.info-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e6ecf4;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .k {
  width: 150rpx;
  flex: none;
  color: #7c8a9b;
  font-size: 26rpx;
}

.info-item .v {
  flex: 1;
  font-size: 28rpx;
}

.desc-text {
  color: #4d5e72;
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

/* ---------- 底部固定操作栏 ---------- */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #e6ecf4;
}

.bottom-action .hint {
  text-align: center;
  font-size: 25rpx;
  color: #7c8a9b;
  margin-bottom: 16rpx;
}

/* ---------- 管理 / 我的 ---------- */
.manage-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 12rpx 36rpx rgba(23, 59, 103, 0.07);
}

.manage-card .mc-title {
  flex: 1;
  margin-right: 16rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.manage-card .actions {
  display: flex;
  margin-top: 22rpx;
  border-top: 1rpx dashed #e6ecf4;
  padding-top: 22rpx;
}

.manage-card .actions .btn {
  flex: 1;
  margin-right: 12rpx;
}

.manage-card .actions .btn:last-child {
  margin-right: 0;
}

.roster-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e6ecf4;
}

.roster-row:last-child {
  border-bottom: none;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8effa;
  color: #173b67;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  flex: none;
  margin-right: 20rpx;
}

.roster-row .who {
  flex: 1;
  min-width: 0;
}

.roster-row .who .name {
  font-weight: 600;
  font-size: 28rpx;
}

.roster-row .who .time {
  font-size: 23rpx;
  color: #7c8a9b;
}

.profile-card {
  background: linear-gradient(150deg, #1a3f6d, #2c5c90);
  color: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 20rpx 52rpx rgba(23, 59, 103, 0.22);
}

.profile-card .avatar-lg {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  margin-right: 28rpx;
}

.profile-card .name {
  font-size: 40rpx;
  font-weight: 700;
}

.profile-card .role {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 4rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e6ecf4;
  font-size: 28rpx;
}

.profile-row:last-child {
  border-bottom: none;
}

.profile-row .k {
  color: #7c8a9b;
}

.profile-row .arrow {
  color: #b8c3d1;
  margin-left: 12rpx;
}

/* ---------- 登录 ---------- */
.login-brand {
  text-align: center;
  margin: 20rpx 0 40rpx;
}

.login-brand .logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(150deg, #1a3f6d, #2f5f95);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  box-shadow: 0 20rpx 44rpx rgba(23, 59, 103, 0.25);
}

.login-brand .login-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.login-brand .login-sub {
  display: block;
  color: #7c8a9b;
  font-size: 25rpx;
}

.quick-fill {
  display: flex;
  margin-bottom: 28rpx;
}

.quick-fill .chip {
  flex: 1;
  text-align: center;
  margin-right: 16rpx;
}

.quick-fill .chip:last-child {
  margin-right: 0;
}

/* ---------- 头部行（标题 + 刷新） ---------- */
.row-between {
  display: flex;
  align-items: center;
  margin: 0 8rpx 20rpx;
}

.row-between .left {
  font-size: 25rpx;
  color: #7c8a9b;
}

.row-between .btn {
  margin-left: auto;
}
